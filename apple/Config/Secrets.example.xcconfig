// Copiare in Config/Secrets.xcconfig (non va nel repository) e completare.
// Client OAuth Google di tipo "TVs and Limited Input devices" (lo stesso dell'app Android va bene).
PHOTOS_CLIENT_ID = 000000000000-example.apps.googleusercontent.com
PHOTOS_CLIENT_SECRET = example-secret
// Team ID Apple Developer (10 caratteri), visibile in developer.apple.com > Membership.
DEVELOPMENT_TEAM = ABCDE12345
