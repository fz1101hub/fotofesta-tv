// Copiare in Config/Secrets.xcconfig (non va nel repository) e completare.
// Client OAuth Google di tipo "Applicazione web" (lo stesso dell'app Android va bene), con la pagina
// site/google/ del sito pubblicato come URI di reindirizzamento (docs/CONFIGURATION.md).
// Lasciati vuoti, l'app non mostra Google Foto e funziona con le foto dimostrative.
PHOTOS_CLIENT_ID =
PHOTOS_CLIENT_SECRET =
// In un xcconfig "//" inizia un commento: l'indirizzo si scrive con "$()" dopo i due punti, ad esempio
// PHOTOS_REDIRECT_URI = https:/$()/utente.github.io/fotofesta-tv/google/
PHOTOS_REDIRECT_URI =
// Team ID Apple Developer (10 caratteri), visibile in developer.apple.com > Membership.
DEVELOPMENT_TEAM =
