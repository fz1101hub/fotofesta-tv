<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox, obbligatoria per il Mac App Store. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Google Foto, iCloud e server DLNA della rete di casa. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Server per le foto degli invitati e per la pagina del consenso Google, sulla rete di casa. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Album della libreria Foto del Mac. -->
	<key>com.apple.security.personal-information.photos-library</key>
	<true/>
	<!-- Copia di sicurezza facoltativa delle foto degli invitati in Immagini/FotoFesta. -->
	<key>com.apple.security.assets.pictures.read-write</key>
	<true/>
	<!-- Configurazione da esportare e importare e cartella a caldo, scelte dall'utente. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- Fotocamera collegata con il cavo USB (Image Capture). -->
	<key>com.apple.security.device.usb</key>
	<true/>
	<!-- Cabina fotografica con la fotocamera del Mac. -->
	<key>com.apple.security.device.camera</key>
	<true/>
</dict>
</plist>
